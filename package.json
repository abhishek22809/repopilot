{
  "name": "repopilot",
  "version": "0.1.0",
  "private": true,
  "description": "RepoPilot - AI Repository Navigator",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @repopilot/api",
    "dev:web": "npm run dev -w @repopilot/web",
    "dev:mcp": "npm run dev -w @repopilot/mcp-server",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build -w @repopilot/web",
    "build:api": "npm run build -w @repopilot/api",
    "build:mcp": "npm run build -w @repopilot/mcp-server",
    "build:backend": "npm run build:mcp && npm run build:api",
    "start": "npm run start:api",
    "start:api": "npm run start -w @repopilot/api",
    "preview:web": "npm run preview -w @repopilot/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "test:api": "npm run test -w @repopilot/api",
    "test:mcp": "npm run test -w @repopilot/mcp-server",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "verify:hooks": "node .cursor/hooks/verify.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
