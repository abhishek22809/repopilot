# Copy this file to .env and fill in real values locally.
# Never commit .env. All values below are placeholders.

# --- API server (apps/api) ---
NODE_ENV=development
PORT=4000
# Origin allowed by CORS (the Vite dev server)
WEB_ORIGIN=http://localhost:5173
# Express "trust proxy": 0/false ignores X-Forwarded-For (dev default). Behind a known
# proxy (e.g. Render) set this to the number of proxy hops so per-IP rate limits work.
TRUST_PROXY=0

# --- Per-IP rate limits (apps/api; all optional) ---
# Sliding window length in milliseconds
RATE_LIMIT_WINDOW_MS=60000
# Max repository connection (POST /api/repos) requests per IP per window
RATE_LIMIT_CONNECT_MAX=10
# Max repository browsing (files/search/file) requests per IP per window
RATE_LIMIT_BROWSE_MAX=120

# --- Web app (apps/web) ---
# Leave empty in development to use the Vite proxy (/api -> http://localhost:4000)
VITE_API_BASE_URL=

# --- Repository fetching (apps/api, Phase 3) ---
# Directory (relative to repo root or absolute) for temporary repository workspaces
REPOS_TMP_DIR=.tmp/repos
# Optional server token to raise *public* GitHub API rate limits. Never used to open
# private repositories (those need a per-request token from the user). Leave as the
# placeholder to run unauthenticated.
GITHUB_TOKEN=your_github_token_here
# How long a connected repository session lives before auto-cleanup (minutes)
SESSION_TTL_MINUTES=30
# Safety limits (all optional; sensible defaults are used if unset)
REPO_MAX_DOWNLOAD_MB=50
REPO_MAX_FILE_MB=2
REPO_MAX_FILES=5000
REPO_DOWNLOAD_TIMEOUT_MS=30000

# --- MCP explorer tools (Phase 4; all optional) ---
# Max search matches returned, and max characters per matching line
MCP_MAX_SEARCH_RESULTS=200
MCP_MAX_LINE_LENGTH=300

# --- Gemini AI integration (Phase 5; all optional) ---
# API key for Google Gemini. Leave as the placeholder to run RepoPilot WITHOUT AI
# (repository browsing/search/read still work; the Ask panel reports AI is disabled).
# Read on the backend only — never exposed to the frontend, bundle, logs, or responses.
GEMINI_API_KEY=your_gemini_api_key_here
# Model id used for answering questions (configurable)
GEMINI_MODEL=gemini-3.5-flash-lite
# Per-request timeout for Gemini calls (milliseconds)
GEMINI_TIMEOUT_MS=30000
